# Supabase — Dashboard → Project Settings → API
# URL is always the Project URL (https://….supabase.co).

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public / low-privilege key (safe for clients if you ever ship one):
#   Prefer new publishable key (sb_publishable_…) when shown.
#   Legacy anon JWT still works during migration.
SUPABASE_ANON_KEY=

# Backend-only — full access; never ship to browsers or public repos:
#   Prefer new secret key (sb_secret_…) when shown.
#   Legacy service_role JWT still works during migration.
SUPABASE_SERVICE_ROLE_KEY=

# MCP server — which agent this server acts as (raw API key from agent creation).
# Format: "<api_key_prefix>.<raw_secret>" (single dot separates prefix and secret).
MYCEL_AGENT_KEY=

# CLI: mycel agent create — Supabase Auth user UUID that owns new agents (Dashboard → Authentication → Users).
MYCEL_OWNER_USER_ID=

# CLI: mycel token create — base URL printed for GET /memories/public?token=… (no trailing slash).
MYCEL_PUBLIC_API_BASE=http://127.0.0.1:3000

# Optional: local Supabase CLI (`supabase start`)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
